# Copy to keystore.properties (gitignored) only when the AOSP platform test
# keystore is present on this machine. Do not commit key material.
#
# Required certificate SHA-256 (colonless):
# c8a2e9bccf597c2fb6dc66bee293fc13f2fc47ec77bc6b2b0d52c11f51192ab8
#
# Verify before building, e.g.:
#   keytool -list -v -keystore <storeFile> -storepass <storePassword>
#
storeFile=path/to/platform.jks
storePassword=
keyAlias=platform
keyPassword=
